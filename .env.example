# PostgreSQL 연결 정보
DATABASE_URL="postgresql://user:password@localhost:5432/playground"

# NextAuth(Auth.js) 세션/토큰 암호화 키. `bunx auth secret`으로 생성
AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 관리자(ERP) 앱이 API를 호출할 수 있도록 CORS를 허용할 오리진. 완전히 다른 도메인/포트에서 뜨는 별도 리액트 프로젝트.
ADMIN_APP_ORIGIN="http://localhost:5173"
