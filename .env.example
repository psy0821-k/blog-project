# PostgreSQL 연결 정보
DATABASE_URL="postgresql://user:password@localhost:5432/playground"

# NextAuth(Auth.js) 세션/토큰 암호화 키. `bunx auth secret`으로 생성
AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 로그인을 허용할 유일한 이메일. 이 블로그는 운영자 1인만 로그인/가입 가능하도록 제한한다.
ADMIN_EMAIL=""

# ImageKit (https://imagekit.io/dashboard/developer/api-keys) — 이미지/동영상 업로드·전송
# 공개 키는 브라우저에 노출되어도 되지만, 비공개 키는 서버 전용이라 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
