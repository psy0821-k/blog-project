generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 사용자 권한
enum Role {
  /// 일반 사용자
  USER
  /// 관리자
  ADMIN
}

/// 게시글 종류
enum PostType {
  /// 프로젝트 소개글
  PROJECT
  /// 실험/학습 기록
  LAB
  /// 개발 일지
  DEV_LOG
}

/// 미디어 파일 종류. URL만으로는 이미지/동영상을 안정적으로 구분할 수 없어(확장자 없는 CDN URL 등)
/// 렌더링 분기(img/video 태그)와 업로드 처리
/// 파이프라인 분기(이미지 전용 Sharp 처리)를 위해 명시적으로 저장한다.
enum MediaType {
  /// 이미지
  IMAGE
  /// 동영상
  VIDEO
}

model User {
  id    String  @id @default(uuid())
  email String  @unique
  name  String?
  role  Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   Account[]
  posts      Post[]
  bookmarks  Bookmark[]
  siteVisits SiteVisit[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  type              String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Post {
  id           String   @id @default(uuid())
  type         PostType
  title        String
  slug         String   @unique
  thumbnailUrl String?
  content      String

  // 임시 저장 시에 사용
  published       Boolean @default(false)
  viewCount       Int     @default(0)
  metaTitle       String?
  metaDescription String?
  authorId        String
  author          User    @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PROJECT 글일 때: 이 프로젝트에 속한 제작과정(DEV_LOG) 글들
  devLogs   Post[]  @relation("ProjectDevLogs")
  // DEV_LOG 글일 때: 이 글이 속한 프로젝트
  projectId String?
  project   Post?   @relation("ProjectDevLogs", fields: [projectId], references: [id])

  media     Media[]
  postTags  PostTag[]
  bookmarks Bookmark[]

  @@index([type, published])
  @@index([authorId])
  @@index([projectId])
}

model Media {
  id   String    @id @default(uuid())
  url  String
  type MediaType

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Bookmark {
  id String @id @default(uuid())

  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model SiteVisit {
  id     String  @id @default(uuid())
  path   String
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
}
