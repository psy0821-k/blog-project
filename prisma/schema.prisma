generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PostType {
  PROJECT
  LAB
  DEV_LOG
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)

  username String? @unique
  bio      String?
  website  String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   Account[]
  sessions   Session[]
  posts      Post[]
  bookmarks  Bookmark[]
  siteVisits SiteVisit[]
}

// NextAuth(Auth.js) OAuth 연동 정보 (Google 등 provider별 계정 매핑)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth(Auth.js) 세션
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 비밀번호 변경 시 특정 유저의 전체 세션 무효화 등에 사용
  @@index([userId])
}

// Auth.js 표준 모델. 이 프로젝트는 OAuth(Google/GitHub)만 사용하지만
// PrismaAdapter가 내부적으로 참조할 수 있어 유지
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id           String   @id @default(cuid())
  type         PostType
  title        String
  slug         String   @unique
  thumbnailUrl String?
  content      String
  published    Boolean  @default(false)
  viewCount    Int      @default(0)

  metaTitle       String?
  metaDescription String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media     Media[]
  bookmarks Bookmark[]
  tags      PostTag[]

  relatedTo   PostRelation[] @relation("ProjectRelations")
  relatedFrom PostRelation[] @relation("DevLogRelations")

  @@index([type, published])
  @@index([authorId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// 프로젝트(PROJECT) ↔ 공부글(DEV_LOG) 연결. 다대다(하나의 프로젝트에 여러 공부글,
// 하나의 공부글이 여러 프로젝트에 연결 가능)
model PostRelation {
  id String @id @default(cuid())

  projectId String
  devLogId  String

  project Post @relation("ProjectRelations", fields: [projectId], references: [id], onDelete: Cascade)
  devLog  Post @relation("DevLogRelations", fields: [devLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, devLogId])
  @@index([devLogId])
}

model Media {
  id    String    @id @default(cuid())
  url   String
  type  MediaType
  order Int       @default(0)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId, order])
}

model Bookmark {
  id String @id @default(cuid())

  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model SiteVisit {
  id String @id @default(cuid())

  path   String
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
}
